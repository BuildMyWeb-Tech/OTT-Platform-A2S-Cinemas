# Copy to .env. Only EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
# The Razorpay key id is delivered by the server in the create-order response, so the
# client needs no Razorpay variable at all. The Razorpay SECRET must never appear here.
EXPO_PUBLIC_API_URL=http://<LAN_IP>:5000/api
