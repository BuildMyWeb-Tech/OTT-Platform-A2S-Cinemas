# Copy to .env (never commit .env). On Render, set these in the service Environment tab.

# ── Razorpay (SERVER ONLY — the secret must never reach the client/EAS/Expo public vars) ──
# Production keys start with rzp_live_, test keys with rzp_test_
RAZORPAY_KEY_ID=<PRODUCTION_RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<PRODUCTION_RAZORPAY_SECRET>

# ── Other required settings (see your existing .env for real values) ──
# MONGODB_URI=
# JWT_SECRET=
# BREVO_API_KEY=
# OTP_FROM_EMAIL=
